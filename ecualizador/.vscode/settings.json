{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "editor.formatOnSave": true,
  "editor.rulers": [88],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".venv": false
  },
  "emmet.includeLanguages": { "jinja-html": "html" },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  }
}
