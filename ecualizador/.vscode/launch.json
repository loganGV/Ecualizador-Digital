      "justMyCode": true
    },
    {
      "name": "▶ FPS EQ — Arduino Linux",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--port", "/dev/ttyUSB0"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
